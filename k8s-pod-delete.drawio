        <mxCell id="oj0FEFrcZWZfxPrtZs2M-72" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontColor=#000000;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fillStyle=solid;" value="ReplicaSet controller&lt;br&gt;keeps replicas = 3" vertex="1">
          <mxGeometry height="70" width="180" x="230" y="345" as="geometry" />
        </mxCell>
        <mxCell id="oj0FEFrcZWZfxPrtZs2M-73" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontColor=#000000;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fillStyle=solid;" value="EndpointSlice controller&lt;br&gt;keeps the endpoint list" vertex="1">
          <mxGeometry height="70" width="180" x="420" y="345" as="geometry" />
        </mxCell>
        <mxCell id="oj0FEFrcZWZfxPrtZs2M-74" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fillStyle=solid;" value="kube-scheduler&lt;br&gt;chooses the node" vertex="1">
          <mxGeometry height="70" width="170" x="640" y="345" as="geometry" />
        </mxCell>
        <mxCell id="oj0FEFrcZWZfxPrtZs2M-75" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#000000;fillColor=#ffffff;strokeColor=#999999;spacing=6;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fillStyle=solid;rounded=0;" value="How to read this picture:&lt;br&gt;- Components never call each other. Each one WATCHES the API server (dashed arrows) and writes its result back to it. The state lives in etcd.&lt;br&gt;- The numbers on the arrows are the steps listed in the two boxes below.&lt;br&gt;- Lane A (delete) and lane B (replace) start almost at the same time. Inside each lane the steps follow the numbers." vertex="1">
          <mxGeometry height="150" width="580" x="220" y="480" as="geometry" />
        </mxCell>
        <mxCell id="oj0FEFrcZWZfxPrtZs2M-76" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontStyle=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fillStyle=solid;" value="kubelet" vertex="1">
          <mxGeometry height="60" width="150" x="900" y="300" as="geometry" />
        </mxCell>
        <mxCell id="oj0FEFrcZWZfxPrtZs2M-77" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fillStyle=solid;" value="kube-proxy&lt;br&gt;(Service traffic rules)" vertex="1">
          <mxGeometry height="60" width="150" x="1080" y="300" as="geometry" />
        </mxCell>
        <mxCell id="oj0FEFrcZWZfxPrtZs2M-78" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fillStyle=solid;" value="containerd&lt;br&gt;(container runtime)" vertex="1">
          <mxGeometry height="60" width="150" x="900" y="420" as="geometry" />
        </mxCell>
        <mxCell id="oj0FEFrcZWZfxPrtZs2M-79" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fillStyle=solid;" value="Calico CNI&lt;br&gt;(Pod interface, route, IP)" vertex="1">
          <mxGeometry height="60" width="150" x="1080" y="420" as="geometry" />
        </mxCell>
        <mxCell id="oj0FEFrcZWZfxPrtZs2M-80" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontStyle=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fillStyle=solid;" value="NEW Pod&lt;br&gt;(created by ReplicaSet)" vertex="1">
          <mxGeometry height="60" width="110" x="895" y="545" as="geometry" />
        </mxCell>
        <mxCell id="oj0FEFrcZWZfxPrtZs2M-81" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fillStyle=solid;" value="Pod&lt;br&gt;(still running)" vertex="1">
          <mxGeometry height="60" width="110" x="1015" y="545" as="geometry" />
        </mxCell>
        <mxCell id="oj0FEFrcZWZfxPrtZs2M-82" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;dashed=1;fontStyle=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fillStyle=solid;" value="Pod&lt;br&gt;(DELETED)" vertex="1">
          <mxGeometry height="60" width="110" x="1135" y="545" as="geometry" />
        </mxCell>
        <mxCell id="oj0FEFrcZWZfxPrtZs2M-83" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#000000;fillColor=#ffffff;strokeColor=#999999;spacing=6;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fillStyle=solid;rounded=0;" value="Service web (ClusterIP 10.102.217.188) is an API object, not a process. kube-proxy turns it into rules using the endpoint list." vertex="1">
          <mxGeometry height="80" width="350" x="895" y="635" as="geometry" />
        </mxCell>
        <mxCell id="oj0FEFrcZWZfxPrtZs2M-84" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#000000;fillColor=#f8cecc;strokeColor=#b85450;spacing=8;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fillStyle=solid;rounded=0;" value="&lt;b&gt;Lane A: DELETE the old Pod&lt;/b&gt;&lt;br&gt;&lt;b&gt;1&lt;/b&gt; kubectl sends &quot;delete pod&quot; to the API server.&lt;br&gt;&lt;b&gt;2&lt;/b&gt; The API server saves it in etcd (Pod is marked Terminating).&lt;br&gt;&lt;b&gt;3&lt;/b&gt; EndpointSlice controller removes the Pod IP from the endpoints.&lt;br&gt;&lt;b&gt;4&lt;/b&gt; kube-proxy sees the endpoint change and updates its rules.&lt;br&gt;&lt;b&gt;5&lt;/b&gt; kubelet on w1 sees that the Pod is terminating.&lt;br&gt;&lt;b&gt;6&lt;/b&gt; kubelet asks containerd to stop the container.&lt;br&gt;&lt;b&gt;7&lt;/b&gt; kubelet asks Calico to remove the Pod interface, route and IP." vertex="1">
          <mxGeometry height="260" width="520" x="200" y="740" as="geometry" />
        </mxCell>
        <mxCell id="oj0FEFrcZWZfxPrtZs2M-85" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#000000;fillColor=#d5e8d4;strokeColor=#82b366;spacing=8;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fillStyle=solid;rounded=0;" value="&lt;b&gt;Lane B: REPLACE it with a new Pod&lt;/b&gt;&lt;br&gt;&lt;b&gt;8&lt;/b&gt; ReplicaSet controller sees 2 of 3 Pods and creates a new Pod object (no node yet, status Pending).&lt;br&gt;&lt;b&gt;9&lt;/b&gt; kube-scheduler chooses w1 and writes it into the Pod through the API server.&lt;br&gt;&lt;b&gt;10&lt;/b&gt; kubelet on w1 sees &quot;this Pod is assigned to me&quot;.&lt;br&gt;&lt;b&gt;11&lt;/b&gt; kubelet asks containerd to start the container.&lt;br&gt;&lt;b&gt;12&lt;/b&gt; kubelet asks Calico to give the Pod a network and IP (together with 11).&lt;br&gt;&lt;b&gt;13&lt;/b&gt; Pod becomes Ready: EndpointSlice controller adds its IP (as in 3), kube-proxy updates the rules (as in 4). Now traffic can reach it." vertex="1">
          <mxGeometry height="260" width="520" x="740" y="740" as="geometry" />
        </mxCell>
        <mxCell id="oj0FEFrcZWZfxPrtZs2M-86" edge="1" parent="1" source="oj0FEFrcZWZfxPrtZs2M-66" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;fontStyle=1;fontSize=14;labelBackgroundColor=default;exitX=0.5;exitY=1;entryX=0.5;entryY=0;sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" target="oj0FEFrcZWZfxPrtZs2M-70" value="1">
          <mxGeometry relative="1" x="-0.7" as="geometry" />
